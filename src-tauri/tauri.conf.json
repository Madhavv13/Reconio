{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reconio",
  "version": "0.1.0",
  "identifier": "app.reconio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Reconio",
        "width": 1440,
        "height": 900,
        "minWidth": 640,
        "minHeight": 480,
        "zoomHotkeysEnabled": true,
        "backgroundColor": "#0A0807"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/subfinder",
      "binaries/dnsx",
      "binaries/httpx"
    ],
    "shortDescription": "Desktop recon for authorized security testing"
  }
}