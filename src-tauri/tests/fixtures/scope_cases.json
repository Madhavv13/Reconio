{
  "$comment": "Scope regression corpus (PRD §17). Every case must pass; a failure blocks a release. check 2 = hostname only (decide_host), check 3 = hostname plus resolved IPs (decide). rule = normalized form of the deciding rule, or null.",
  "decisions": [
    { "name": "exact domain", "in": ["acme.example"], "out": [], "host": "acme.example", "check": 2, "verdict": "in", "rule": "acme.example" },
    { "name": "domain does not cover subdomains", "in": ["acme.example"], "out": [], "host": "www.acme.example", "check": 2, "verdict": "out", "rule": null },
    { "name": "wildcard one level", "in": ["*.acme.example"], "out": [], "host": "www.acme.example", "check": 2, "verdict": "in", "rule": "*.acme.example" },
    { "name": "wildcard any depth", "in": ["*.acme.example"], "out": [], "host": "a.b.c.acme.example", "check": 2, "verdict": "in", "rule": "*.acme.example" },
    { "name": "wildcard not its base", "in": ["*.acme.example"], "out": [], "host": "acme.example", "check": 2, "verdict": "out", "rule": null },
    { "name": "wildcard not a lookalike suffix", "in": ["*.acme.example"], "out": [], "host": "evilacme.example", "check": 2, "verdict": "out", "rule": null },
    { "name": "trailing dot on host", "in": ["*.acme.example"], "out": [], "host": "WWW.Acme.Example.", "check": 2, "verdict": "in", "rule": "*.acme.example" },
    { "name": "trailing dot on rule", "in": ["acme.example."], "out": [], "host": "acme.example", "check": 2, "verdict": "in", "rule": "acme.example" },
    { "name": "IDN rule, punycode host", "in": ["*.bücher.example"], "out": [], "host": "shop.xn--bcher-kva.example", "check": 2, "verdict": "in", "rule": "*.xn--bcher-kva.example" },
    { "name": "IDN host, punycode rule", "in": ["*.xn--bcher-kva.example"], "out": [], "host": "shop.bücher.example", "check": 2, "verdict": "in", "rule": "*.xn--bcher-kva.example" },
    { "name": "out wildcard beats in wildcard", "in": ["*.acme.example"], "out": ["*.legacy.acme.example"], "host": "x.legacy.acme.example", "check": 2, "verdict": "out", "rule": "*.legacy.acme.example" },
    { "name": "out wildcard leaves its base", "in": ["*.acme.example"], "out": ["*.legacy.acme.example"], "host": "legacy.acme.example", "check": 2, "verdict": "in", "rule": "*.acme.example" },
    { "name": "out domain beats in wildcard", "in": ["*.acme.example"], "out": ["status.acme.example"], "host": "status.acme.example", "check": 2, "verdict": "out", "rule": "status.acme.example" },
    { "name": "out domain beats identical in domain", "in": ["acme.example"], "out": ["acme.example"], "host": "acme.example", "check": 2, "verdict": "out", "rule": "acme.example" },
    { "name": "nested in under out", "in": ["*.acme.example", "*.api.legacy.acme.example"], "out": ["*.legacy.acme.example"], "host": "v1.api.legacy.acme.example", "check": 2, "verdict": "out", "rule": "*.legacy.acme.example" },
    { "name": "pattern inner star one label", "in": ["api-*.acme.example"], "out": [], "host": "api-eu.acme.example", "check": 2, "verdict": "in", "rule": "api-*.acme.example" },
    { "name": "pattern inner star never crosses a dot", "in": ["api-*.acme.example"], "out": [], "host": "api-eu.x.acme.example", "check": 2, "verdict": "out", "rule": null },
    { "name": "pattern inner star needs a character", "in": ["api-*.acme.example"], "out": [], "host": "api-.acme.example", "check": 2, "verdict": "out", "rule": null },
    { "name": "pattern leading and middle star", "in": ["*.dev.*.acme.example"], "out": [], "host": "a.dev.eu.acme.example", "check": 2, "verdict": "in", "rule": "*.dev.*.acme.example" },
    { "name": "pattern trailing star", "in": ["www.acme.*"], "out": [], "host": "www.acme.co.uk", "check": 2, "verdict": "in", "rule": "www.acme.*" },
    { "name": "pattern star touching a label", "in": ["*hpe.com"], "out": [], "host": "mail.hpe.com", "check": 2, "verdict": "out", "rule": null },
    { "name": "out pattern", "in": ["*.acme.example"], "out": ["*-staging.acme.example"], "host": "shop-staging.acme.example", "check": 2, "verdict": "out", "rule": "*-staging.acme.example" },
    { "name": "SCOPE-10 pending with CIDR", "in": ["acme.example", "203.0.113.0/24"], "out": [], "host": "vpn.acme.example", "check": 2, "verdict": "pending", "rule": null },
    { "name": "SCOPE-10 pending host in by CIDR", "in": ["acme.example", "203.0.113.0/24"], "out": [], "host": "vpn.acme.example", "ips": ["203.0.113.5"], "check": 3, "verdict": "in", "rule": "203.0.113.0/24" },
    { "name": "SCOPE-10 pending host dropped", "in": ["acme.example", "203.0.113.0/24"], "out": [], "host": "mail.acme.example", "ips": ["198.51.100.7"], "check": 3, "verdict": "out", "rule": null },
    { "name": "SCOPE-10 pending host with no IPs dropped", "in": ["acme.example", "203.0.113.0/24"], "out": [], "host": "gone.acme.example", "ips": [], "check": 3, "verdict": "out", "rule": null },
    { "name": "no pending without in IP rules", "in": ["acme.example"], "out": ["198.51.100.0/24"], "host": "vpn.acme.example", "check": 2, "verdict": "out", "rule": null },
    { "name": "out hostname beats in CIDR", "in": ["203.0.113.0/24"], "out": ["*.legacy.acme.example"], "host": "a.legacy.acme.example", "ips": ["203.0.113.9"], "check": 3, "verdict": "out", "rule": "*.legacy.acme.example" },
    { "name": "out CIDR drops an in host", "in": ["*.acme.example"], "out": ["203.0.113.200/29"], "host": "a.acme.example", "ips": ["203.0.113.201"], "check": 3, "verdict": "out", "rule": "203.0.113.200/29" },
    { "name": "one out IP among several", "in": ["*.acme.example"], "out": ["203.0.113.7"], "host": "a.acme.example", "ips": ["203.0.113.6", "203.0.113.7"], "check": 3, "verdict": "out", "rule": "203.0.113.7" },
    { "name": "IPv6 CIDR in", "in": ["2001:db8::/32"], "out": [], "ips": ["2001:db8:5::1"], "check": 3, "verdict": "in", "rule": "2001:db8::/32" },
    { "name": "IPv6 outside", "in": ["2001:db8::/32"], "out": [], "ips": ["2001:db9::1"], "check": 3, "verdict": "out", "rule": null },
    { "name": "IPv6 single address, other spelling", "in": ["2001:DB8:0:0::1"], "out": [], "ips": ["2001:db8::1"], "check": 3, "verdict": "in", "rule": "2001:db8::1" },
    { "name": "CIDR stored by network address", "in": ["203.0.113.77/24"], "out": [], "ips": ["203.0.113.1"], "check": 3, "verdict": "in", "rule": "203.0.113.0/24" },
    { "name": "URL rule reduces to host", "in": ["https://portal.acme.example:8443/login"], "out": [], "host": "portal.acme.example", "check": 2, "verdict": "in", "rule": "portal.acme.example" }
  ],
  "parsing": [
    { "name": "dash bullet in the In box stays in", "in_text": "- *.acme.example", "out_text": "", "rules": [["wildcard", "in", "*.acme.example"]] },
    { "name": "star bullet then wildcard", "in_text": "* *.acme.example", "out_text": "", "rules": [["wildcard", "in", "*.acme.example"]] },
    { "name": "dash bullet in the Out box", "in_text": "", "out_text": "- *.staging.acme.example\n- help.acme.example", "rules": [["wildcard", "out", "*.staging.acme.example"], ["domain", "out", "help.acme.example"]] },
    { "name": "bang in the In box moves out", "in_text": "acme.example\n!status.acme.example", "out_text": "", "rules": [["domain", "in", "acme.example"], ["domain", "out", "status.acme.example"]] },
    { "name": "commas, spaces and comments", "in_text": "a.example, b.example c.example # three\n# skip", "out_text": "", "rules": [["domain", "in", "a.example"], ["domain", "in", "b.example"], ["domain", "in", "c.example"]] },
    { "name": "URL with path", "in_text": "https://acme.example/portal", "out_text": "", "rules": [["domain", "in", "acme.example"]] },
    { "name": "invalid lines are not rules", "in_text": "203.0.113.300\n*.\nacme", "out_text": "", "rules": [] }
  ]
}
